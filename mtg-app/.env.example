# Copy to .env.local (dev) or set at build time (prod).
# VITE_POCKETBASE_URL is required — the app will not start without it.

# PocketBase API (required)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Optional: MTGJSON price update API
VITE_PRICE_API_URL=

# Optional: Sentry DSN
VITE_SENTRY_DSN=

# Optional: admin "build + reload" webhook URL (same origin recommended).
# Never put a deploy secret in VITE_* — the webhook authenticates via PocketBase admin session.
VITE_DEPLOY_HOOK_URL=

# Optional: WebRTC ICE servers as JSON (STUN + TURN). Public Google STUN is the default.
# Required for one-way-audio fixes (remote player behind hard NAT). See docs/WEBRTC_TURN_SETUP.md
# Credentials are visible in the client bundle — use a dedicated coturn user.
# VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.mtg-app.duckdns.org:3478?transport=udp","turn:turn.mtg-app.duckdns.org:3478?transport=tcp"],"username":"mtgturn","credential":"CHANGE_ME"},{"urls":"turns:turn.mtg-app.duckdns.org:5349","username":"mtgturn","credential":"CHANGE_ME"}]
VITE_ICE_SERVERS=
