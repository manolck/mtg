# Monitor admin API (bind 127.0.0.1:9091)
PORT=9091
POCKETBASE_URL=http://127.0.0.1:8090
# ALLOWED_ORIGIN=https://mtg-app.duckdns.org
MONITOR_UNITS=play-sync,coturn,nginx,pocketbase
PLAY_SYNC_HEALTH=http://127.0.0.1:8091/health
DISK_PATH=/
# MagicCorporation JSON served by the SPA root (nginx root /var/www/mtg-app)
MAGICCORP_OUTPUT=/var/www/mtg-app/magiccorporation-cards.json
MAGICCORP_SCRIPT=/opt/mtg-app/scripts/scrape-magiccorporation.js
# MAGICCORP_DELAY_MS=1000
