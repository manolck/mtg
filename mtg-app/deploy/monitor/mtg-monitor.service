[Unit]
Description=MTG admin monitor (stats + journal logs)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/mtg/mtg-app
EnvironmentFile=/etc/mtg-monitor.env
ExecStart=/usr/bin/node /var/www/mtg/mtg-app/scripts/monitor-server.cjs
Restart=on-failure
RestartSec=3

# journalctl access:
#   sudo usermod -aG systemd-journal www-data
# then re-login / reboot

[Install]
WantedBy=multi-user.target
