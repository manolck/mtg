{
  "$comment": "Source of truth for PocketBase collection API rules. Apply in PocketBase Admin → each collection → API rules. See README.md (PocketBase).",
  "users": {
    "listRule": "@request.auth.id != \"\"",
    "viewRule": "@request.auth.id != \"\"",
    "createRule": null,
    "updateRule": "@request.auth.id != \"\" && id = @request.auth.id",
    "deleteRule": "@request.auth.id != \"\" && id = @request.auth.id",
    "notes": "createRule empty/null = only PocketBase superusers can create users (no public signup)."
  },
  "user_collections": {
    "listRule": "@request.auth.id != \"\"",
    "viewRule": "@request.auth.id != \"\"",
    "createRule": "userId = @request.auth.id",
    "updateRule": "userId = @request.auth.id",
    "deleteRule": "userId = @request.auth.id",
    "notes": "Authenticated users can list collections (multi-collection browse). Writes restricted to owner."
  },
  "cards": {
    "listRule": "@request.auth.id != \"\"",
    "viewRule": "@request.auth.id != \"\"",
    "createRule": "@request.auth.id != \"\"",
    "updateRule": "@request.auth.id != \"\"",
    "deleteRule": "@request.auth.id != \"\"",
    "notes": "Shared card catalog. Any authenticated user may create/update catalog rows used as relations."
  },
  "collection_items": {
    "listRule": "@request.auth.id != \"\"",
    "viewRule": "@request.auth.id != \"\"",
    "createRule": "@request.body.userCollectionId.userId = @request.auth.id",
    "updateRule": "userCollectionId.userId = @request.auth.id && (@request.body.userCollectionId:isset = false || @request.body.userCollectionId.userId = @request.auth.id)",
    "deleteRule": "userCollectionId.userId = @request.auth.id",
    "notes": "List/view open to authenticated users for multi-collection browse. CUD owner-only."
  },
  "decks": {
    "listRule": "@request.auth.id != \"\" && (@request.auth.id = userId || visibility = \"public\")",
    "viewRule": "@request.auth.id != \"\" && (@request.auth.id = userId || visibility = \"public\" || visibility = \"unlisted\")",
    "createRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "updateRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "deleteRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "notes": "Owners manage their decks. Authenticated users can list public decks and view public/unlisted by id. Forks are independent records (sourceDeckId has cascadeDelete: false)."
  },
  "imports": {
    "listRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "viewRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "createRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "updateRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "deleteRule": "@request.auth.id != \"\" && @request.auth.id = userId"
  },
  "wishlist": {
    "listRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "viewRule": "@request.auth.id != \"\" && @request.auth.id = userId",
    "createRule": "userId = @request.auth.id",
    "updateRule": "userId = @request.auth.id",
    "deleteRule": "userId = @request.auth.id",
    "notes": "Private to owner. Do not use tautology list rules such as (@request.auth.id = userId || @request.auth.id != \"\")."
  },
  "legal": {
    "listRule": "userId = @request.auth.id",
    "viewRule": "userId = @request.auth.id",
    "createRule": "userId = @request.auth.id",
    "updateRule": "userId = @request.auth.id",
    "deleteRule": "userId = @request.auth.id",
    "notes": "GDPR consent records are private to the owner."
  },
  "play_lobbies": {
    "listRule": "@request.auth.id != \"\" && status != \"closed\"",
    "viewRule": "@request.auth.id != \"\" && (status != \"closed\" || hostId = @request.auth.id)",
    "createRule": "@request.auth.id != \"\" && hostId = @request.auth.id",
    "updateRule": "@request.auth.id != \"\" && hostId = @request.auth.id",
    "deleteRule": "@request.auth.id != \"\" && (hostId = @request.auth.id || (@collection.users.id(@request.auth.id).roles != null && @collection.users.id(@request.auth.id).roles ~ \"admin\"))",
    "notes": "Authenticated users can see open/playing lobbies. Host owns writes. Admins can delete any lobby. Join is enforced on play_seats (waiting + free seat)."
  },
  "play_seats": {
    "listRule": "@request.auth.id != \"\" && lobbyId.status != \"closed\"",
    "viewRule": "@request.auth.id != \"\" && lobbyId.status != \"closed\"",
    "createRule": "@request.auth.id != \"\" && userId = @request.auth.id && lobbyId.status = \"waiting\"",
    "updateRule": "@request.auth.id != \"\" && (userId = @request.auth.id || lobbyId.hostId = @request.auth.id) && lobbyId.status != \"closed\"",
    "deleteRule": "@request.auth.id != \"\" && (userId = @request.auth.id || lobbyId.hostId = @request.auth.id)",
    "notes": "Join only while waiting. Seat owner or host can update/leave. deckSnapshot is a JSON copy of the chosen deck at ready/start."
  },
  "play_matches": {
    "listRule": "@request.auth.id != \"\" && (@request.auth.id = updatedBy || playerIds.id ?= @request.auth.id)",
    "viewRule": "@request.auth.id != \"\" && (@request.auth.id = updatedBy || playerIds.id ?= @request.auth.id)",
    "createRule": "@request.auth.id != \"\" && lobbyId.hostId = @request.auth.id",
    "updateRule": "@request.auth.id != \"\" && (@request.auth.id = updatedBy || playerIds.id ?= @request.auth.id)",
    "deleteRule": "@request.auth.id != \"\" && @request.auth.id = lobbyId.hostId",
    "notes": "Snapshot state + actionSeq for bootstrap. Live truth is play_match_actions (append-only)."
  },
  "play_match_actions": {
    "listRule": "@request.auth.id != \"\" && matchId.playerIds.id ?= @request.auth.id",
    "viewRule": "@request.auth.id != \"\" && matchId.playerIds.id ?= @request.auth.id",
    "createRule": "@request.auth.id != \"\" && matchId.playerIds.id ?= @request.auth.id && userId = @request.auth.id",
    "updateRule": null,
    "deleteRule": null,
    "notes": "Append-only action journal. One row per play action; clients apply by actionId idempotently."
  },
  "play_rtc_signals": {
    "listRule": "@request.auth.id != \"\" && (@request.auth.id = fromUserId || @request.auth.id = toUserId)",
    "viewRule": "@request.auth.id != \"\" && (@request.auth.id = fromUserId || @request.auth.id = toUserId)",
    "createRule": "@request.auth.id != \"\" && fromUserId = @request.auth.id",
    "updateRule": null,
    "deleteRule": "@request.auth.id != \"\" && (@request.auth.id = fromUserId || @request.auth.id = toUserId)",
    "notes": "Ephemeral WebRTC signaling. List/create for the two peers; delete after apply. No updates."
  }
}
